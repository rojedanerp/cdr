rules_version = '2';

// ============================================
// REGLAS DE SEGURIDAD — Remesas Pro (cdremesas)
// Solo personal autenticado (con cuenta creada en
// Authentication) puede leer y escribir datos.
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Remesas: cada envío registrado
    match /remesas/{remesaId} {
      allow read, write: if request.auth != null;
    }

    // Clientes: personas que envían/reciben dinero
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }

    // Tasas de cambio: valores usados para autocompletar "Nueva Remesa"
    match /tasasCambio/{tasaId} {
      allow read, write: if request.auth != null;
    }

    // Por defecto, todo lo demás queda bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
